# =============================================
# CareerPilot Backend — Environment Variables
# Copy this file to .env and fill in values
# =============================================

# ----------------------------------
# Google Gemini API (REQUIRED)
# Get from: aistudio.google.com/app/apikey
# NO FALLBACK — must be valid
# ----------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here

# ----------------------------------
# Neon DB — PostgreSQL Connection
# Get from: console.neon.tech
#   → Your Project → Connection Details → Connection string
#
# RUNTIME (asyncpg) — used by the FastAPI app
# Format: postgresql+asyncpg://user:pass@host/db?sslmode=require
# ----------------------------------
DATABASE_URL=postgresql+asyncpg://username:password@ep-example-xxxxx.us-east-1.aws.neon.tech/careerpilot?sslmode=require

# ----------------------------------
# JWT Security
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------
JWT_SECRET_KEY=replace_with_your_64_char_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ----------------------------------
# CORS — allowed frontend origins
# Comma-separated, no trailing slash
# ----------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# ----------------------------------
# Application Settings
# ----------------------------------
APP_NAME=CareerPilot
APP_VERSION=2.0.0
APP_ENV=development

# ----------------------------------
# Gemini Model Config (optional overrides)
# ----------------------------------
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_DIM=768

# ----------------------------------
# File Uploads
# ----------------------------------
UPLOAD_DIR=./temp_uploads
MAX_UPLOAD_SIZE_MB=10

# ----------------------------------
# Server Port
# Render injects PORT automatically — leave as 8000 for local dev
# ----------------------------------
PORT=8000