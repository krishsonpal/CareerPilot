# CareerPilot Worker — Environment Variables
# Copy this file to .env and fill in the values.

# ── Google Gemini API ───────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# ── PostgreSQL (Neon DB) ────────────────────────────────────
# Sync connection string (no asyncpg needed for Node.js pg)
DATABASE_URL=postgresql://user:password@host:5432/careerpilot

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # Uncomment if Redis is password-protected

# ── Worker HTTP Server ──────────────────────────────────────
WORKER_PORT=3001

# ── Python FastAPI (optional, for internal callbacks) ───────
API_BASE_URL=http://localhost:8000
